# Copy this file to .env and fill in values before running the app.
# Never commit .env to version control.

# Flask secret key — used to sign session cookies.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
# Without this set, a new random key is generated on every restart (logs all users out).
SECRET_KEY=replace-me-with-a-strong-random-value
